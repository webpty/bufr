{
  "name": "bufr",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-build-env.mjs",
    "build": "npm run check && vite build",
    "check": "tsc -b",
    "serve": "npm run build && node scripts/serve-built.mjs",
    "test": "node test/api-test.mjs && node test/page-test.mjs",
    "db:local": "wrangler d1 execute bufr-db --local --persist-to .wrangler/state --file",
    "db:remote": "wrangler d1 execute bufr-db --remote --file"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.22.0",
    "@heroui-pro/react": "^1.0.0-beta.10",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.12.4",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "vite": "^8.3.0",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "@heroui-pro/react": true,
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  }
}
